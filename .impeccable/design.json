  "narrative": {
    "northStar": "The Imperial Doorway",
    "overview": "The actual artwork opens an imperial fantasy world. Ink, wine-purple, crimson light, ivory and aged metal give the interior a nocturnal, ceremonial character. Large subject-specific images and book typography carry the atmosphere; controls stay recognizable and prose stays stable.\n\nThe system alternates expansive artwork with compact working collections and legible dossiers. Depth comes chiefly from dark tonal planes, restrained frames and image composition. This is a companion to an authored historical fantasy, so visual emphasis follows real artwork and verified records.",
    "keyCharacteristics": [
      "Artwork leads; controls remain immediately available.",
      "Local book faces support both English and Vietnamese.",
      "Tonal planes and aged-metal frames organize the dark interior.",
      "Choreographed image motion ends at stable, readable content."
    ],
    "rules": [
      {
        "name": "The One Theme Owner Rule",
        "body": "Reuse the existing world and royal role variables so faction changes also reach portals and global destinations.",
        "section": "colors"
      },
      {
        "name": "The Language Face Rule",
        "body": "Resolve typography through `--type-heading` and `--type-body`; keep Vietnamese diacritics visible and preserve the loaded font weights.",
        "section": "typography"
      },
      {
        "name": "The Framed Group Rule",
        "body": "Borders describe a working group, field or significant frame; do not put a white plaque beneath every label.",
        "section": "elevation"
      },
      {
        "name": "The Stable Prose Rule",
        "body": "Animate the image and transition state; keep the reading text out of atmospheric motion.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** use actual subject artwork at a useful scale and preserve its focal subject.",
